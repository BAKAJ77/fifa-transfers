{
    "version": 9,
    "cmakeMinimumRequired": 
    {
        "major": 3,
        "minor": 24,
        "patch": 1
    },
    "configurePresets": 
    [
        {
            "name": "Win64-Debug",
            "displayName": "Win64-Debug",
            "description": "A 64-bit Windows debug build using Ninja generator.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/win64/debug",
            "installDir": "${sourceDir}/install/win64/debug",
            "cacheVariables": 
            {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "Win64-Release",
            "displayName": "Win64-Release",
            "description": "A 64-bit Windows release build using Ninja generator.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/win64/release",
            "installDir": "${sourceDir}/install/win64/release",
            "cacheVariables": 
            {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_SHARED_LIBS": "OFF",
                "JSON_BuildTests": "OFF"
            }
        }
    ]
}